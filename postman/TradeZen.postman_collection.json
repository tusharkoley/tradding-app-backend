{
  "info": {
    "name": "TradeZen Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "All registered application API methods from the local Django routes. Select a supplied environment, fill credentials and run requests individually. Includes destructive and balance-changing requests; do not run the whole collection against a live account. Admin HTML pages and automatic OPTIONS/HEAD variants are not listed. Remote code may differ. See README.md for signup 400 troubleshooting and known backend limitations."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                ""
              ]
            },
            "description": "Public registration. Use a real, unused email and a strong password of at least 8 characters. Optional fields: middle_name, phone_number (international format). Omit empty phone numbers. Local code sends activation email and creates an inactive, non-staff account. A 400 response contains field errors; 503 means email delivery failed. Remote deployments may run older code.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Postman\",\n  \"last_name\": \"Tester\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 400) {",
                  "  let errors;",
                  "  try { errors = pm.response.json(); } catch (_) { errors = {response: \"Non-JSON response; inspect the response body.\"}; }",
                  "  Object.keys(errors).forEach(function (field) {",
                  "    pm.test(\"Sign-up validation: \" + field + \": \" + JSON.stringify(errors[field]), function () {",
                  "      throw new Error(\"Inspect the response body and correct this field.\");",
                  "    });",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Activate account",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/activate/{{activation_uid}}/{{activation_token}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "activate",
                "{{activation_uid}}",
                "{{activation_token}}",
                ""
              ]
            },
            "description": "Copy UID and token from the activation email. Returns HTML. HTTP 200 alone does not prove activation: invalid tokens also return 200.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Account activated\", function () { pm.expect(pm.response.text()).not.to.include(\"invalid token\"); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login \u2014 save tokens and user ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "login",
                ""
              ]
            },
            "description": "Saves access_token, refresh_token and user_id to the selected environment. Activate the account first. No token-refresh endpoint is registered; log in again when access expires.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.test(\"Access and refresh tokens returned\", function () {",
                  "    pm.expect(data.access).to.be.a(\"string\");",
                  "    pm.expect(data.refresh).to.be.a(\"string\");",
                  "  });",
                  "  pm.environment.set(\"access_token\", data.access);",
                  "  pm.environment.set(\"refresh_token\", data.refresh);",
                  "  const CryptoJS = require(\"crypto-js\");",
                  "  const payload = data.access.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\");",
                  "  const claims = JSON.parse(CryptoJS.enc.Base64.parse(payload).toString(CryptoJS.enc.Utf8));",
                  "  if (claims.user_id !== undefined) pm.environment.set(\"user_id\", String(claims.user_id));",
                  "} else {",
                  "  pm.environment.unset(\"access_token\");",
                  "  pm.environment.unset(\"refresh_token\");",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Request password reset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/password-reset/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "password-reset",
                ""
              ]
            },
            "description": "Sends a link to the frontend reset form. Returns the same message for known and unknown email addresses. Mail delivery failures return 503.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Confirm password reset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/password-reset-confirm/{{reset_uid}}/{{reset_token}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "password-reset-confirm",
                "{{reset_uid}}",
                "{{reset_token}}",
                ""
              ]
            },
            "description": "Copy UID/token from the frontend reset link in the email. Requires matching strong passwords. Returns JSON; invalid, expired or already-used links return 400. After success, update the password environment variable before logging in again.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password1\": \"{{new_password}}\",\n  \"password2\": \"{{new_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) pm.test(\"Password updated\", function () { pm.expect(pm.response.json().message).to.include(\"Password updated\"); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
